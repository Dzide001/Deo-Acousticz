.gradle/
.idea/
*.iml
local.properties
android/build/
android/app/build/
android/.cxx/
android/captures/
android/app/release/

# ─── CMake / NDK ───────────────────────────────────────────────────────────────
cmake-build-*/
CMakeFiles/
CMakeCache.txt
*.cmake
